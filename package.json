{
  "name": "anixweb-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node --test tests/browser.mjs tests/socialBrowser.mjs tests/attachmentsBrowser.mjs",
    "test:social:browser": "node --test tests/socialBrowser.mjs",
    "sync:protocol": "node scripts/sync-protocol.mjs",
    "test:attachments:browser": "node --test tests/attachmentsBrowser.mjs"
  },
  "overrides": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "esbuild": "^0.28.1",
    "miniflare": "^5.20261006.0-alpha",
    "typescript": "~6.0.2",
    "wrangler": "^4.148.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261006.1": true
  }
}
